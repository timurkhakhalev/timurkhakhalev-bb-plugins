{
  "name": "bb-plugin-browser-annotate",
  "version": "0.1.0",
  "description": "Annotate elements in a BB Browser tab and send comments with per-element screenshots to the current chat.",
  "type": "module",
  "homepage": "https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins/tree/main/plugins/browser-annotate",
  "bugs": {
    "url": "https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins.git",
    "directory": "plugins/browser-annotate"
  },
  "files": [
    "dist",
    "src/app.tsx",
    "src/composer.ts",
    "src/contracts.ts",
    "src/editor-placement.ts",
    "src/host.ts",
    "src/server.ts",
    "src/shortcut.ts",
    "scripts/check-published-sdk.mjs",
    "tsconfig.published-sdk.json",
    "README.md",
    "PLUGIN_OVERVIEW.md"
  ],
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit && bun test",
    "check:published-sdk": "bun scripts/check-published-sdk.mjs && tsc --project tsconfig.published-sdk.json --noEmit",
    "test": "bun test",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.88",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "bun-types": "^1.4.2",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.89"
  },
  "bb": {
    "name": "Browser Annotate",
    "description": "Annotate elements in a BB Browser tab and send the comments with per-element screenshots to the current chat.",
    "branding": {
      "icon": "MessageSquare"
    },
    "server": "./src/server.ts",
    "host": "./src/host.ts",
    "app": "./src/app.tsx"
  }
}
