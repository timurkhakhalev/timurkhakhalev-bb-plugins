  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins.git",
    "directory": "plugins/compact-composer"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md"
  ],
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit"
  },
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.60"
  },
  "bb": {
