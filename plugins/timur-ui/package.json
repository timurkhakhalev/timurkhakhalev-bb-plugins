    "app": "./src/app.tsx"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
