{
  "name": "bb-plugin-timur-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Timur's personal bb look: a shorter composer with the footer in the action row, plus Beautiful Chat's restyled chat (messages, work rows, loaders, approval cards, changed files).",
  "type": "module",
  "homepage": "https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins/tree/main/plugins/timur-ui",
  "bugs": {
    "url": "https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timurkhakhalev/timurkhakhalev-bb-plugins.git",
    "directory": "plugins/timur-ui"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE-beautiful-chat"
  ],
  "scripts": {
