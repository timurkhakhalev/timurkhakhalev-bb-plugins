{
  "compilerOptions": {
    "strict": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@get-bb/plugin-sdk": ["types/bb-plugin-sdk.d.ts"],
      "@get-bb/plugin-sdk/app": ["types/bb-plugin-sdk-app.d.ts"],
      "@get-bb/plugin-sdk/host": ["types/bb-plugin-sdk.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
